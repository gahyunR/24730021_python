# % 서식문자 - 자료형에 맞게 값을 출력
# %d 정수, %f 실수, %s 문자열, %c 문자
print("제 이름은 %s 입니다." % name)


# %s - 여러 값을 문자열 형태로 출력
print("제 이름은 %s 입니다. 저는 %s 살 입니다." % (name, age))


# f-string 활용해서 문자열 출력
print(f"제 이름은 {name}입니다, 저는 {age} 살 입니다.")


# format() 활용해서 문자열 출력
print("제 이름은 {}입니다, 저는 {} 살 입니다.".format(name, age))


# format() - 번호를 지정하여 출력 순서 정의
print("제 이름은 {0}입니다, 저는 {1} 살 입니다.".format(name, age))


# format() - 번호를 생략하면 순서대로 출력
