#집합 출력 - 요소의 출력 순서가 정해져 있지 않음 
fruits = {"apple", "banana", "grape"}
print(fruits)

#for문 - 집합의 요소를 하나씩 출력
fruits = {"apple", "banana", "grape"}

for x in fruits:
    print(x, end=" ")
print()

# sorted() - 오름차순 정렬
fruits = {"apple", "banana", "grape"}

for x in sorted(fruits):
    print(x, end=" ")
print()

# sorted(reverse = True) - 내림차순 정리 
fruits = {"apple", "banana", "grape"}

for x in sorted(fruits, reverse = True):
    print(x, end=" ")
print()

#add() - 집합에 요소 추가 
fruits = {"apple", "banana", "grape"}
fruits.add("kiwi")
print(fruits)

#remove() - 집합에서 요소 삭제 
#존재하지 않는 요소를 삭제하면 오류 발생
fruits = {"apple", "banana", "grape"}
fruits.remove("kiwi")
print(fruits)

#discard() - 요소 삭제, 없는 요소여도 오류가 발생하지 않음 
fruits = {"apple", "banana", "grape"}
fruits.discard("O")
print(fruits)

# clear() - 집합의 모든 요소 삭제
fruits = {"apple", "banana", "grape"}
fruits.clear()
print(fruits)

# 딕셔너리 - key와 value로 구성 
num = {"one":1, "two":2, "three":3}
print(num["one"]) #대괄호 []안에 key를 입력하여 value 출력
print(num["four"]) #존재하지 않는 key를 조회하면 key Error 발생 

#get() - 특정 key에 해장하는 value 가져오기 
print(num.get("one"))

#get() - 존재하지 않는 key를 조회해도 오류가 발생하지 않음
print(num.get("four", "해당키가 없습니다."))

# get() - 요소별 개수 세기
fruits - {"apple", "banana","apple", "melon", "banana", "apple"}
count = {}

for fruit in fruits:
    count[fruit] = count.get)fruit, 0) + 1

print(count)

